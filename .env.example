UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_SHEETS_CSV_URL=
EXAMS_CSV_URL=

# Neon PostgreSQL
DATABASE_URL=

# NextAuth v5 (generate: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin seed script (not needed at runtime)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Superadmin (email-based privilege in admin panel)
SUPERADMIN_EMAIL=

# Public (client) API URLs - prefix with NEXT_PUBLIC_
NEXT_PUBLIC_ACADEMIC_CALENDAR_URL=
NEXT_PUBLIC_BLOOD_DONORS_API_URL=
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_STYLE_LIGHT=

# Cloudinary (team photos — server upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only API URLs
CP_USERNAMES_API_URL=
CODEFORCES_API_BASE=

#Rag Base URL
RAG_API=

# ──────────────────────────────────────────────────────────────────────────
# Paddle Billing (Freemium / premium subscriptions)
# Create products & prices in your Paddle dashboard, then fill these in.
# Leave NEXT_PUBLIC_PADDLE_CLIENT_TOKEN empty to keep checkout disabled
# (the Upgrade buttons will route to the Pricing page instead).
# ──────────────────────────────────────────────────────────────────────────
# "sandbox" for testing (no domain approval needed) or "production" when live.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token from Paddle > Developer Tools > Authentication.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs (pri_...) from your Paddle catalog.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# Server-side secrets.
PADDLE_API_KEY=
# Secret for verifying webhook signatures (Paddle > Notifications).
PADDLE_WEBHOOK_SECRET=

